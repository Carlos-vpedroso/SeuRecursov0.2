# =========================
# 🗄️ Database
# =========================
DATABASE_URL="postgresql://user:password@localhost:5432/seurecurso"

# =========================
# 🔐 Segurança
# =========================
JWT_TOKEN="your_jwt_secret_here"
ENCRYPTION_KEY="your_encryption_key_here"
ADMIN_KEY="your_admin_key_here"

# =========================
# 🔴 Redis
# =========================
REDIS_URL="redis://localhost:6379"

# =========================
# 🏦 SICOOB (PIX)
# =========================
SICOOB_CLIENT_ID="your_sicoob_client_id"
SICOOB_CERT_PASSWORD="your_cert_password"
SICOOB_CERT_BASE64="your_base64_certificate"
SICOOB_PIX_KEY="your_pix_key"

# =========================
# 💳 InfinitePay
# =========================
INFINITEPAY_API_URL="https://api.infinitepay.io"
INFINITEPAY_HANDLE="your_handle"
INFINITEPAY_REDIRECT_URL="http://localhost:3000/pagamento/sucesso"
INFINITEPAY_WEBHOOK_URL="http://localhost:3000/api/webhook/infinitepay"